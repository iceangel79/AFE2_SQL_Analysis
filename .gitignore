# --- Daten: NIE ins Repo (öffentliches Repo, mögliche Personendaten) ---
data/raw/*
data/processed/*
data/manual/*
output/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/manual/.gitkeep
!output/.gitkeep
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.parquet
*.xlsx
*.csv
!config/*.csv
!config/templates/*.csv
!tests/fixtures/*

